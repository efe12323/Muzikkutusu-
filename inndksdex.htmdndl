<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NFC Kart Analiz Aracı</title>
    <style>
        :root {
            --bg: #0f0f12;
            --card: #1a1a22;
            --accent: #00ff9d;
            --text: #e0e0e0;
        }
        * { margin:0; padding:0; box-sizing:border-box; }
        body {
            font-family: system-ui, sans-serif;
            background: var(--bg);
            color: var(--text);
            padding: 16px;
            line-height: 1.5;
        }
        .container { max-width: 1100px; margin: 0 auto; }
        h1 { text-align:center; background: linear-gradient(90deg,#00ff9d,#00cc7a); -webkit-background-clip:text; -webkit-text-fill-color:transparent; margin-bottom:8px; }
        
        button {
            width: 100%; max-width: 420px; margin: 30px auto; display:block;
            padding: 22px; font-size: 1.4rem; font-weight:600;
            background: linear-gradient(135deg,#00ff9d,#00cc7a); color:#000;
            border:none; border-radius:16px; cursor:pointer;
        }
        button:disabled { opacity:0.6; }

        .card {
            background: var(--card);
            border-radius: 16px;
            padding: 20px;
            margin: 20px 0;
            border: 1px solid #333;
        }
        .log {
            background:#0a0a0c; border:1px solid #333; border-radius:12px;
            height: 220px; overflow-y:auto; padding:14px; font-family:monospace; font-size:0.9rem;
        }
        .record {
            background:#25252e; padding:16px; margin:12px 0; border-radius:12px; border:1px solid #444;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>NFC Kart Analiz Aracı</h1>
        <button id="scanBtn">📱 NFC KARTINI OKU</button>

        <div id="results" style="display:none;">
            <div class="card">
                <h2>📋 Kart Bilgileri</h2>
                <p><strong>UID:</strong> <span id="uid"></span></p>
            </div>

            <div class="card" id="recordsPanel">
                <h2>📦 NDEF Kayıtları</h2>
                <div id="records"></div>
            </div>

            <div class="card">
                <h2>🔬 Ham Veri (HEX)</h2>
                <pre id="hexData" style="background:#111; padding:16px; border-radius:8px; overflow:auto; font-size:0.85rem;"></pre>
            </div>
        </div>

        <div class="card">
            <h3>📜 Log</h3>
            <div id="log" class="log"></div>
        </div>
    </div>

    <script>
        const scanBtn = document.getElementById('scanBtn');
        const results = document.getElementById('results');
        const uidEl = document.getElementById('uid');
        const recordsEl = document.getElementById('records');
        const hexEl = document.getElementById('hexData');
        const logEl = document.getElementById('log');

        function log(msg, type = '') {
            const time = new Date().toLocaleTimeString('tr-TR');
            const entry = document.createElement('div');
            entry.innerHTML = `<strong>[${time}]</strong> ${msg}`;
            if (type === 'error') entry.style.color = '#ff6666';
            if (type === 'success') entry.style.color = '#00ff9d';
            logEl.appendChild(entry);
            logEl.scrollTop = logEl.scrollHeight;
        }

        function hexString(buffer) {
            return Array.from(new Uint8Array(buffer))
                .map(b => b.toString(16).padStart(2, '0').toUpperCase())
                .join(' ');
        }

        function asciiString(buffer) {
            return Array.from(new Uint8Array(buffer))
                .map(b => (b >= 32 && b <= 126) ? String.fromCharCode(b) : '.')
                .join('');
        }

        async function startScan() {
            if (!('NDEFReader' in window)) {
                log('Web NFC desteklenmiyor.', 'error');
                return;
            }

            try {
                scanBtn.disabled = true;
                log('🔄 Tarama başlatılıyor...', 'success');

                const ndef = new NDEFReader();
                await ndef.scan();

                log('✅ Tarama aktif - Kart yaklaştırın', 'success');

                ndef.onreading = event => {
                    log('🎉 Kart Okundu!', 'success');
                    
                    results.style.display = 'block';
                    uidEl.textContent = event.serialNumber || 'Yok';

                    let allData = new Uint8Array();

                    if (event.message && event.message.records.length > 0) {
                        recordsEl.innerHTML = '';
                        
                        event.message.records.forEach((record, i) => {
                            const div = document.createElement('div');
                            div.className = 'record';
                            
                            let content = `<strong>Kayıt ${i+1}:</strong> ${record.recordType}<br>`;
                            
                            if (record.data) {
                                const hex = hexString(record.data);
                                const ascii = asciiString(record.data);
                                
                                content += `<strong>HEX:</strong> ${hex}<br>`;
                                content += `<strong>ASCII:</strong> ${ascii}<br>`;
                                
                                // Text ise okumaya çalış
                                if (record.recordType === 'text') {
                                    try {
                                        const decoder = new TextDecoder(record.encoding || 'utf-8');
                                        content += `<strong>İçerik:</strong> ${decoder.decode(record.data)}`;
                                    } catch(e) {}
                                }
                            }
                            
                            div.innerHTML = content;
                            recordsEl.appendChild(div);

                            // Tüm veriyi birleştir
                            if (record.data) {
                                const combined = new Uint8Array(allData.length + record.data.byteLength);
                                combined.set(allData);
                                combined.set(new Uint8Array(record.data), allData.length);
                                allData = combined;
                            }
                        });
                    } else {
                        recordsEl.innerHTML = '<p style="color:#888">Bu kartta NDEF kaydı bulunamadı.</p>';
                    }

                    // Genel HEX
                    hexEl.textContent = hexString(allData) || 'Veri yok';
                };

                ndef.onreadingerror = () => {
                    log('❌ Kart okunamadı veya desteklenmiyor.', 'error');
                };

            } catch (err) {
                log(`Hata: ${err.message || err}`, 'error');
                console.error(err);
                scanBtn.disabled = false;
            }
        }

        scanBtn.addEventListener('click', startScan);

        log('🚀 NFC Analiz Aracı hazır. Butona basın.', 'success');
    </script>
</body>
</html>
